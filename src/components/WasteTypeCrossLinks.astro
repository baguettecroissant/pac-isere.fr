---
interface Props {
    cityName: string;
    citySlug: string;
    currentCategory: "main" | "gravats" | "encombrants" | "dechets-verts" | "dib";
}

const { cityName, citySlug, currentCategory } = Astro.props;

const allCategories = [
    { key: "gravats" as const, href: "location-benne-gravats", label: "Gravats", icon: "🪨", color: "border-orange-100 hover:border-orange-400 hover:bg-orange-50/30" },
    { key: "encombrants" as const, href: "location-benne-encombrants", label: "Encombrants", icon: "📦", color: "border-blue-100 hover:border-blue-400 hover:bg-blue-50/30" },
    { key: "dechets-verts" as const, href: "location-benne-dechets-verts", label: "Déchets Verts", icon: "🌿", color: "border-green-100 hover:border-green-400 hover:bg-green-50/30" },
    { key: "dib" as const, href: "location-benne-dib", label: "DIB", icon: "🏭", color: "border-purple-100 hover:border-purple-400 hover:bg-purple-50/30" },
];

const otherCategories = allCategories.filter(c => c.key !== currentCategory);
---

<section class="features" style="background: var(--white); border-top: 1px solid var(--border-color);">
    <div class="container" style="max-width: 800px;">
        <h2 style="font-size: 22px; font-weight: 800; color: var(--secondary-color); text-align: center; margin-bottom: 24px;">
            Autres types de bennes à {cityName}
        </h2>
        
        <div class="options-grid" style="grid-template-columns: repeat(3, 1fr); max-w: 600px; margin: 0 auto;">
            {otherCategories.map((cat) => (
                <a
                    href={`/${cat.href}-${citySlug}`}
                    class={`option-box ${cat.color}`}
                    style="padding: 15px; border-width: 1px;"
                >
                    <span style="font-size: 28px; margin-bottom: 8px;">{cat.icon}</span>
                    <span style="font-weight: 700; font-size: 13px; color: var(--secondary-color);">{cat.label}</span>
                </a>
            ))}
        </div>

        {currentCategory !== "main" && (
            <div style="margin-top: 24px; text-align: center;">
                <a href={`/location-benne-${citySlug}`} style="color: var(--accent-color); font-weight: 700; font-size: 14px;">
                    &larr; Voir tous les tarifs bennes à {cityName}
                </a>
            </div>
        )}
    </div>
</section>
