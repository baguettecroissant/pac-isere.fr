---
// ExitIntentPopup.astro
---

<div class="exit-intent-backdrop" id="exit-intent-backdrop" aria-hidden="true" role="dialog">
  <div class="exit-intent-modal">
    <!-- Top colored decorative bar -->
    <div class="modal-stripe"></div>
    
    <!-- Close Button -->
    <button class="close-modal-btn" id="close-modal-btn" aria-label="Fermer la fenêtre">&times;</button>
    
    <!-- Content -->
    <div class="modal-body">
      <div class="modal-icon">🎁</div>
      <h3>Attendez ! Ne partez pas sans vos aides...</h3>
      <p class="modal-desc">
        En Isère, l'État finance <strong>jusqu'à 90%</strong> du coût d'installation de votre pompe à chaleur RGE en 2026. Calculez vos subventions en moins de 2 minutes.
      </p>
      
      <!-- Bullet Points -->
      <ul class="modal-bullets">
        <li>
          <span class="bullet-check">✓</span>
          <span><strong>MaPrimeRénov' & Prime CEE :</strong> Jusqu'à 13 500 € cumulables</span>
        </li>
        <li>
          <span class="bullet-check">✓</span>
          <span><strong>Zéro Reste à Charge Absurde :</strong> Étude 100% gratuite & sans engagement</span>
        </li>
        <li>
          <span class="bullet-check">✓</span>
          <span><strong>Installateurs RGE locaux :</strong> Artisans partenaires qualifiés en Isère (38)</span>
        </li>
      </ul>
      
      <!-- CTA Buttons -->
      <div class="modal-actions">
        <button class="btn-primary pulse-btn" id="exit-popup-cta">
          📋 Estimer mes aides gratuites &rarr;
        </button>
        <button class="opt-out-btn" id="exit-popup-opt-out">
          Non merci, je préfère payer mes factures de chauffage plein tarif
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .exit-intent-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(6px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .exit-intent-backdrop.show {
    display: flex;
    opacity: 1;
  }

  .exit-intent-modal {
    background: #ffffff;
    border-radius: var(--radius-lg);
    width: 92%;
    max-width: 520px;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
    border: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
    transform: scale(0.92);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    padding: 35px 30px;
  }

  .exit-intent-backdrop.show .exit-intent-modal {
    transform: scale(1);
  }

  .modal-stripe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 6px;
    background: linear-gradient(90deg, var(--accent-color), var(--secondary-color));
  }

  .close-modal-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 28px;
    line-height: 1;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--text-muted);
    transition: var(--transition);
  }

  .close-modal-btn:hover {
    color: var(--text-dark);
    transform: scale(1.1);
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .modal-icon {
    font-size: 3.2rem;
    margin-bottom: 15px;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .modal-body h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--secondary-color);
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .modal-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .modal-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 25px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    text-align: left;
  }

  .modal-bullets li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13.5px;
    color: var(--text-dark);
  }

  .bullet-check {
    background: rgba(59, 130, 246, 0.1);
    color: var(--accent-color);
    font-weight: 800;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .modal-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  /* Pulsing button effect */
  .pulse-btn {
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(59, 130, 246, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
    }
  }

  .opt-out-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 11px;
    cursor: pointer;
    text-decoration: underline;
    transition: var(--transition);
    padding: 4px;
    line-height: 1.4;
  }

  .opt-out-btn:hover {
    color: #b91c1c;
  }

  /* Global pulse highlight for lead forms on CTA click */
  :global(.pulse-form) {
    animation: formPulseGlow 1s ease-in-out infinite alternate !important;
    transition: all 0.3s ease !important;
  }

  @keyframes formPulseGlow {
    from {
      box-shadow: var(--shadow-lg), 0 0 0 0px rgba(59, 130, 246, 0.4) !important;
      border-color: var(--border-color) !important;
    }
    to {
      box-shadow: var(--shadow-lg), 0 0 0 10px rgba(59, 130, 246, 0.25) !important;
      border-color: var(--accent-color) !important;
    }
  }
</style>

<script>
  // Script executes in the browser client
  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('exit-intent-backdrop');
    const closeBtn = document.getElementById('close-modal-btn');
    const ctaBtn = document.getElementById('exit-popup-cta');
    const optOutBtn = document.getElementById('exit-popup-opt-out');

    if (!backdrop) return;

    // Check if the user has already dismissed or completed the popup during this session
    const isShownKey = 'pac_exit_popup_shown';
    const isDismissed = localStorage.getItem(isShownKey);

    if (isDismissed === 'true') {
      return; // Stop here if already dismissed
    }

    const showModal = () => {
      localStorage.setItem(isShownKey, 'true'); // Save state so it triggers only once
      backdrop.style.display = 'flex';
      // Force repaint to trigger CSS transitions
      void backdrop.offsetWidth;
      backdrop.classList.add('show');
    };

    const closeModal = () => {
      backdrop.classList.remove('show');
      setTimeout(() => {
        backdrop.style.display = 'none';
      }, 350);
    };

    // 1. DESKTOP : Trigger when mouse leaves the top viewport
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY < 20) {
        showModal();
      }
    });

    // 2. MOBILE : Trigger when user scrolls past 50% of the page
    let mobileTriggered = false;
    window.addEventListener('scroll', () => {
      if (mobileTriggered) return;
      
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      if (docHeight > 0 && (scrollTop / docHeight) > 0.5) {
        mobileTriggered = true;
        // Trigger with a small delay for better user experience
        setTimeout(showModal, 1000);
      }
    });

    // 3. MOBILE : Trigger if user remains inactive on the page for 25 seconds
    setTimeout(() => {
      if (!mobileTriggered && !localStorage.getItem(isShownKey)) {
        showModal();
      }
    }, 25000);

    // Event Listeners for closing the modal
    closeBtn?.addEventListener('click', closeModal);
    optOutBtn?.addEventListener('click', closeModal);
    
    // Close when clicking outside the modal content box
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.classList.contains('show')) {
        closeModal();
      }
    });

    // CTA Click Event : Scroll to form or redirect
    ctaBtn?.addEventListener('click', () => {
      closeModal();
      
      const targetForm = document.getElementById('devis') || document.getElementById('pac-lead-form');
      if (targetForm) {
        // Form is present on this page -> scroll smoothly
        targetForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
        
        // Highlight form to draw user attention
        targetForm.classList.add('pulse-form');
        setTimeout(() => {
          targetForm.classList.remove('pulse-form');
        }, 3000);

        // Highlight first interactive box
        const firstBox = targetForm.querySelector('.option-box') as HTMLElement;
        if (firstBox) {
          firstBox.focus();
          firstBox.style.outline = '3px solid var(--accent-color)';
          setTimeout(() => {
            firstBox.style.outline = '';
          }, 3000);
        }
      } else {
        // Form is NOT present on this page -> redirect to landing page form anchor
        window.location.href = '/#devis';
      }
    });
  });
</script>
