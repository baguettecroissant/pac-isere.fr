---
import Layout from '../layouts/Layout.astro';
import config from '../data/config.json';
---

<Layout title="Simulateurs & Outils Gratuits Pompe à Chaleur Isère (38)" description="Accédez à nos 3 outils interactifs gratuits : simulateur d'aides Anah 2026, calculateur de puissance (dimensionnement RGE) et comparateur d'économies d'énergie.">
  <section class="section" style="padding: 60px 0; background: #f8fafc;">
    <div class="container" style="max-width: 1150px; margin: 0 auto;">
      
      <!-- Title Section -->
      <div style="text-align: center; margin-bottom: 40px;">
        <span style="font-size: 13px; font-weight: 700; background: rgba(59, 130, 246, 0.1); color: var(--accent-color); padding: 6px 16px; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.5px;">
          🛠️ Espace Simulateurs Officiels Isère (38)
        </span>
        <h1 style="font-size: 2.6rem; font-weight: 800; color: var(--secondary-color); line-height: 1.25; margin-top: 15px;">
          Simulateurs & Outils Énergétiques
        </h1>
        <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 800px; margin: 15px auto 0; line-height: 1.6;">
          Estimez vos primes, dimensionnez votre puissance et comparez vos factures. Basculez d'un outil à l'autre via les onglets ci-dessous.
        </p>
      </div>

      <!-- Tab Navigation Bar -->
      <div class="tabs-nav-container">
        <button class="tab-btn active" data-tab="aides">
          <span class="tab-icon">🧮</span>
          <span class="tab-label">1. Simulateur d'Aides 2026</span>
        </button>
        <button class="tab-btn" data-tab="puissance">
          <span class="tab-icon">📏</span>
          <span class="tab-label">2. Calculateur de Puissance</span>
        </button>
        <button class="tab-btn" data-tab="economies">
          <span class="tab-icon">📉</span>
          <span class="tab-label">3. Simulateur d'Économies</span>
        </button>
      </div>

      <!-- ========================================== -->
      <!-- TAB 1: SIMULATEUR D'AIDES 2026             -->
      <!-- ========================================== -->
      <div class="tab-content active" id="content-aides">
        <div class="simulator-layout">
          <!-- Left Side: Inputs -->
          <div class="sim-card card-inputs">
            <div class="sim-header">
              <h3>📋 Vos informations fiscales & projet</h3>
              <p>Modifiez les valeurs ci-dessous pour mettre à jour les aides en direct.</p>
            </div>
            
            <div class="sim-body">
              <div class="form-section">
                <label class="section-label">1. Nombre de personnes dans le foyer (fiscal)</label>
                <div class="foyer-buttons">
                  <button type="button" class="foyer-btn active" data-value="1">1</button>
                  <button type="button" class="foyer-btn" data-value="2">2</button>
                  <button type="button" class="foyer-btn" data-value="3">3</button>
                  <button type="button" class="foyer-btn" data-value="4">4</button>
                  <button type="button" class="foyer-btn" data-value="5">5</button>
                  <button type="button" class="foyer-btn" data-value="6">6+</button>
                </div>
                <input type="hidden" id="foyer_size" value="1" />
              </div>

              <div class="form-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <label class="section-label" style="margin-bottom: 0;">2. Revenu Fiscal de Référence annuel (RFR)</label>
                  <span id="rfr_display" class="rfr-badge">20 000 €</span>
                </div>
                <input type="range" id="rfr_slider" min="10000" max="100000" step="500" value="20000" class="range-slider" />
                <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); margin-top: 4px;">
                  <span>10 000 €</span>
                  <span>50 000 €</span>
                  <span>100 000 € +</span>
                </div>
              </div>

              <div class="form-section">
                <label class="section-label">3. Chauffage actuel à remplacer</label>
                <div class="options-vertical">
                  <label class="radio-card active">
                    <input type="radio" name="heating_current" value="fioul" checked />
                    <span class="card-icon">🛢️</span>
                    <div class="card-content">
                      <span class="card-title">Chaudière Fioul (Mazout)</span>
                      <span class="card-subtitle">Donne droit à la prime CEE bonifiée</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="heating_current" value="gaz_classique" />
                    <span class="card-icon">🔥</span>
                    <div class="card-content">
                      <span class="card-title">Chaudière Gaz (hors condensation)</span>
                      <span class="card-subtitle">Donne droit à la prime CEE bonifiée</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="heating_current" value="charbon" />
                    <span class="card-icon">🪵</span>
                    <div class="card-content">
                      <span class="card-title">Chaudière Charbon ou Bois</span>
                      <span class="card-subtitle">Donne droit à la prime CEE bonifiée</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="heating_current" value="gaz_condens" />
                    <span class="card-icon">💧</span>
                    <div class="card-content">
                      <span class="card-title">Chaudière Gaz à Condensation</span>
                      <span class="card-subtitle">Prime CEE standard uniquement</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="heating_current" value="electricite" />
                    <span class="card-icon">⚡</span>
                    <div class="card-content">
                      <span class="card-title">Radiateurs Électriques directs</span>
                      <span class="card-subtitle">Prime CEE standard uniquement</span>
                    </div>
                  </label>
                </div>
              </div>

              <div class="form-section">
                <label class="section-label">4. Quel type de PAC souhaitez-vous simuler ?</label>
                <div class="options-vertical">
                  <label class="radio-card active">
                    <input type="radio" name="pac_planned" value="air_eau" checked />
                    <span class="card-icon">💧</span>
                    <div class="card-content">
                      <span class="card-title">Pompe à chaleur Air/Eau (Hydraulique)</span>
                      <span class="card-subtitle">Coût moyen estimé : 14 000 € TTC</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="pac_planned" value="geothermie" />
                    <span class="card-icon">🌍</span>
                    <div class="card-content">
                      <span class="card-title">Pompe à chaleur Géothermique (Sonde/Sol)</span>
                      <span class="card-subtitle">Coût moyen estimé : 22 000 € TTC</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="pac_planned" value="air_air" />
                    <span class="card-icon">❄️</span>
                    <div class="card-content">
                      <span class="card-title">Climatisation Réversible (Air/Air)</span>
                      <span class="card-subtitle">Coût moyen estimé : 6 000 € TTC</span>
                    </div>
                  </label>
                </div>
              </div>

              <div class="form-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <label class="section-label" style="margin-bottom: 0;">5. Montant estimé ou réel des travaux (TTC)</label>
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="number" id="project_cost_input" class="number-input" value="14000" min="2000" max="40000" step="100" />
                    <span style="font-weight: 700; color: var(--secondary-color);">€</span>
                  </div>
                </div>
                <input type="range" id="project_cost_slider" min="2000" max="40000" step="500" value="14000" class="range-slider" />
                <span style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
                  Ajustez ce montant si vous avez déjà reçu un devis ou une estimation d'un professionnel.
                </span>
              </div>
            </div>
          </div>

          <!-- Right Side: Results -->
          <div class="sim-card card-results" style="border: 1.5px solid var(--secondary-color);">
            <div class="results-inner">
              <div class="results-top" style="background: var(--secondary-color);">
                <span class="badge-title">VOTRE ESTIMATION D'AIDES 2026</span>
                <div class="total-aides" id="res_total_aides">12 600 €</div>
                <p style="font-size: 13.5px; color: rgba(255, 255, 255, 0.7); margin-bottom: 20px;">
                  Subventions de l'État déduites directement de votre facture
                </p>
                <div class="profile-card profile-bleu" id="res_profile_card">
                  <span class="profile-dot"></span>
                  <span id="res_profile_name">Profil BLEU (Revenus Très Modestes)</span>
                </div>
              </div>

              <div class="results-middle">
                <div class="summary-row">
                  <span>Coût du projet (moyen) :</span>
                  <strong id="res_project_cost">14 000 €</strong>
                </div>
                <div class="summary-row highlight-row" style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; margin-top: 15px; font-size: 15px; padding: 12px 14px;">
                  <span>Reste à charge estimé :</span>
                  <strong id="res_remaining_charge" style="color: #15803d; font-size: 17px;">1 400 €</strong>
                </div>

                <div style="margin: 20px 0 10px;">
                  <div style="display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 6px;">
                    <span style="color: var(--text-muted); font-weight: 500;">Prise en charge publique :</span>
                    <strong id="res_pct_text" style="color: var(--accent-color);">90%</strong>
                  </div>
                  <div class="progress-bar-bg">
                    <div class="progress-bar-fill" id="res_progress_fill" style="width: 90%;"></div>
                  </div>
                </div>

                <div class="breakdown-list">
                  <h4>Détail des aides cumulables :</h4>
                  <div class="breakdown-item">
                    <div class="item-title">
                      <span>🏠 MaPrimeRénov' (Anah)</span>
                      <span class="info-helper" title="Aide de l'Agence Nationale de l'Habitat.">?</span>
                    </div>
                    <strong id="res_prime_anah">9 000 €</strong>
                  </div>
                  <div class="breakdown-item">
                    <div class="item-title">
                      <span>⚡ Prime CEE (Fournisseurs)</span>
                      <span class="info-helper" title="Certificats d'Économie d'Énergie (Coup de Pouce).">?</span>
                    </div>
                    <strong id="res_prime_cee">4 500 €</strong>
                  </div>
                  <div class="breakdown-item">
                    <div class="item-title">
                      <span>🛡️ Économie TVA 5,5%</span>
                      <span class="info-helper" title="TVA à taux réduit de 5.5% appliquée directement sur le matériel et la main d'œuvre.">?</span>
                    </div>
                    <strong id="res_tva_saving">1 980 €</strong>
                  </div>
                  <div class="breakdown-item">
                    <div class="item-title">
                      <span>🏦 Éco-Prêt à Taux Zéro</span>
                      <span class="info-helper" title="Prêt sans intérêt pour financer votre reste à charge.">?</span>
                    </div>
                    <strong style="color: #166534;" id="res_ptz_status">Éligible</strong>
                  </div>
                </div>
              </div>

              <div class="results-bottom-actions">
                <a href="/#devis" class="btn-primary-results pulse-btn">
                  📋 Bloquer mes aides & Devis RGE &rarr;
                </a>
                <p style="font-size: 11px; color: var(--text-muted); text-align: center; margin-top: 12px; line-height: 1.4;">
                  *Simulation basée sur le barème Anah 2026 (Province). Soumise à la visite technique obligatoire d'un installateur certifié RGE QualiPAC.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 1 Guide -->
        <section class="section" style="padding: 60px 0; border-top: 1px solid var(--border-color); background: #ffffff; margin-top: 40px;">
          <div style="margin-bottom: 40px; text-align: center;">
            <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--secondary-color); margin-bottom: 10px;">
              📊 Barème de Ressources Anah 2026 (Province / Hors Île-de-France)
            </h2>
            <p style="color: var(--text-muted); max-width: 700px; margin: 0 auto; font-size: 14px;">
              Retrouvez les plafonds officiels pour situer votre foyer. L'Isère dépend du barème **Province**.
            </p>
          </div>

          <div class="table-responsive" style="overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-bottom: 30px;">
            <table class="bareme-table">
              <thead>
                <tr style="background: #f1f5f9;">
                  <th>Foyer fiscal</th>
                  <th style="color: #2563eb; background: rgba(59, 130, 246, 0.04);">Profil Bleu<br><small style="font-weight: 500;">Très Modeste</small></th>
                  <th style="color: #ca8a04; background: rgba(234, 179, 8, 0.04);">Profil Jaune<br><small style="font-weight: 500;">Modeste</small></th>
                  <th style="color: #9333ea; background: rgba(168, 85, 247, 0.04);">Profil Violet<br><small style="font-weight: 500;">Intermédiaire</small></th>
                  <th style="color: #e11d48; background: rgba(244, 63, 94, 0.04);">Profil Rose<br><small style="font-weight: 500;">Aisé</small></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="font-weight: 700;">1 personne</td>
                  <td style="background: rgba(59, 130, 246, 0.01);">≤ 17 009 €</td>
                  <td style="background: rgba(234, 179, 8, 0.01);">17 010 € à 21 838 €</td>
                  <td style="background: rgba(168, 85, 247, 0.01);">21 839 € à 32 894 €</td>
                  <td style="background: rgba(244, 63, 94, 0.01);">&gt; 32 894 €</td>
                </tr>
                <tr>
                  <td style="font-weight: 700;">2 personnes</td>
                  <td style="background: rgba(59, 130, 246, 0.01);">≤ 24 875 €</td>
                  <td style="background: rgba(234, 179, 8, 0.01);">24 876 € à 31 889 €</td>
                  <td style="background: rgba(168, 85, 247, 0.01);">31 890 € à 47 983 €</td>
                  <td style="background: rgba(244, 63, 94, 0.01);">&gt; 47 983 €</td>
                </tr>
                <tr>
                  <td style="font-weight: 700;">3 personnes</td>
                  <td style="background: rgba(59, 130, 246, 0.01);">≤ 29 917 €</td>
                  <td style="background: rgba(234, 179, 8, 0.01);">29 918 € à 38 349 €</td>
                  <td style="background: rgba(168, 85, 247, 0.01);">38 350 € à 57 734 €</td>
                  <td style="background: rgba(244, 63, 94, 0.01);">&gt; 57 734 €</td>
                </tr>
                <tr>
                  <td style="font-weight: 700;">4 personnes</td>
                  <td style="background: rgba(59, 130, 246, 0.01);">≤ 34 948 €</td>
                  <td style="background: rgba(234, 179, 8, 0.01);">34 949 € à 44 802 €</td>
                  <td style="background: rgba(168, 85, 247, 0.01);">44 803 € à 67 473 €</td>
                  <td style="background: rgba(244, 63, 94, 0.01);">&gt; 67 473 €</td>
                </tr>
                <tr>
                  <td style="font-weight: 700;">5 personnes</td>
                  <td style="background: rgba(59, 130, 246, 0.01);">≤ 40 002 €</td>
                  <td style="background: rgba(234, 179, 8, 0.01);">40 003 € à 51 281 €</td>
                  <td style="background: rgba(168, 85, 247, 0.01);">51 282 € à 77 206 €</td>
                  <td style="background: rgba(244, 63, 94, 0.01);">&gt; 77 206 €</td>
                </tr>
                <tr>
                  <td style="font-weight: 700;">Par pers. sup.</td>
                  <td style="background: rgba(59, 130, 246, 0.01);">+ 5 033 €</td>
                  <td style="background: rgba(234, 179, 8, 0.01);">+ 6 462 €</td>
                  <td style="background: rgba(168, 85, 247, 0.01);">+ 9 738 €</td>
                  <td style="background: rgba(244, 63, 94, 0.01);">Selon barème</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 30px;">
            <div class="step-guide-card" style="padding: 25px; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: #ffffff;">
              <h4 style="font-size: 1.1rem; font-weight: 800; color: var(--secondary-color); margin-bottom: 10px;">📋 Conditions Administratives</h4>
              <p style="color: var(--text-muted); font-size: 13.5px; line-height: 1.6; margin: 0;">
                Les travaux doivent être réalisés par un installateur qualifié **RGE QualiPAC**. Le dossier d'aides doit être créé en ligne avant d'avoir signé votre devis de travaux. Le logement doit être votre résidence principale construite depuis plus de 15 ans.
              </p>
            </div>
            <div class="step-guide-card" style="padding: 25px; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: #ffffff;">
              <h4 style="font-size: 1.1rem; font-weight: 800; color: var(--secondary-color); margin-bottom: 10px;">💰 Le Mécanisme d'Écrêtement</h4>
              <p style="color: var(--text-muted); font-size: 13.5px; line-height: 1.6; margin: 0;">
                Pour éviter qu'un chantier soit financé à 100% par l'argent public, l'Anah impose des plafonds de prise en charge cumulés (MaPrimeRénov' + CEE) : maximum 90% du montant des travaux pour le profil Bleu (Très Modeste), 75% pour Jaune (Modeste), et 60% pour Violet (Intermédiaire).
              </p>
            </div>
          </div>
        </section>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: CALCULATEUR DE PUISSANCE            -->
      <!-- ========================================== -->
      <div class="tab-content" id="content-puissance" style="display: none;">
        <div class="simulator-layout">
          <!-- Left Side: Inputs -->
          <div class="sim-card card-inputs">
            <div class="sim-header">
              <h3>📋 Paramètres de votre habitation</h3>
              <p>Ajustez les valeurs pour recalculer les déperditions en direct.</p>
            </div>
            
            <div class="sim-body">
              <div class="form-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <label class="section-label" style="margin-bottom: 0;">1. Surface habitable (m²)</label>
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="number" id="input_surface" class="number-input" value="120" min="20" max="400" step="1" />
                    <span style="font-weight: 700; color: var(--secondary-color);">m²</span>
                  </div>
                </div>
                <input type="range" id="slider_surface" min="20" max="400" step="5" value="120" class="range-slider" />
              </div>

              <div class="form-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <label class="section-label" style="margin-bottom: 0;">2. Hauteur sous plafond moyenne (m)</label>
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="number" id="input_height" class="number-input" value="2.5" min="2.0" max="4.5" step="0.1" />
                    <span style="font-weight: 700; color: var(--secondary-color);">m</span>
                  </div>
                </div>
                <input type="range" id="slider_height" min="2.0" max="4.5" step="0.1" value="2.5" class="range-slider" />
              </div>

              <div class="form-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <label class="section-label" style="margin-bottom: 0;">3. Altitude de votre commune (m)</label>
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="number" id="input_altitude" class="number-input" value="200" min="0" max="2000" step="50" />
                    <span style="font-weight: 700; color: var(--secondary-color);">m</span>
                  </div>
                </div>
                <input type="range" id="slider_altitude" min="0" max="2000" step="50" value="200" class="range-slider" />
              </div>

              <div class="form-section">
                <label class="section-label">4. Niveau d'isolation & année de construction</label>
                <div class="options-vertical">
                  <label class="radio-card">
                    <input type="radio" name="insulation_coef" value="0.6" />
                    <span class="card-icon">🍃</span>
                    <div class="card-content">
                      <span class="card-title">Excellente (RT2012 / RT2020)</span>
                      <span class="card-subtitle">Maison neuve ou construite après 2013</span>
                    </div>
                  </label>
                  <label class="radio-card active">
                    <input type="radio" name="insulation_coef" value="0.8" checked />
                    <span class="card-icon">🏡</span>
                    <div class="card-content">
                      <span class="card-title">Bonne isolation (RT2000 / RT2005)</span>
                      <span class="card-subtitle">Maison construite entre 2000 et 2012</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="insulation_coef" value="1.1" />
                    <span class="card-icon">🧱</span>
                    <div class="card-content">
                      <span class="card-title">Isolation moyenne (Années 1980 - 1990)</span>
                      <span class="card-subtitle">Isolation d'époque moyenne</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="insulation_coef" value="1.4" />
                    <span class="card-icon">🏚️</span>
                    <div class="card-content">
                      <span class="card-title">Faible ou non isolé (Avant 1980)</span>
                      <span class="card-subtitle">Vieille passoire thermique non rénovée</span>
                    </div>
                  </label>
                </div>
              </div>

              <div class="form-section">
                <label class="section-label">5. Émetteurs de chauffage intérieur</label>
                <div class="options-vertical">
                  <label class="radio-card active">
                    <input type="radio" name="emitters_type" value="low" checked />
                    <span class="card-icon">♨️</span>
                    <div class="card-content">
                      <span class="card-title">Plancher chauffant / Radiateurs Basse Température</span>
                      <span class="card-subtitle">Eau à 35°C - Rendement maximal (COP élevé)</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="emitters_type" value="med" />
                    <span class="card-icon">🔥</span>
                    <div class="card-content">
                      <span class="card-title">Radiateurs Acier ou Alu classiques</span>
                      <span class="card-subtitle">Eau à 45-50°C - Rendement intermédiaire</span>
                    </div>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="emitters_type" value="high" />
                    <span class="card-icon">🛢️</span>
                    <div class="card-content">
                      <span class="card-title">Radiateurs en Fonte (Haute Température)</span>
                      <span class="card-subtitle">Eau à 65°C+ - Nécessite une PAC Haute Température</span>
                    </div>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Side: Results -->
          <div class="sim-card card-results" style="border: 1.5px solid var(--secondary-color);">
            <div class="results-inner">
              <div class="results-top" style="background: var(--secondary-color);">
                <span class="badge-title">PUISSANCE PAC CONSEILLÉE</span>
                <div class="total-aides" id="res_required_power" style="font-size: 3.5rem;">8.4 kW</div>
