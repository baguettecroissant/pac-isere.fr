    color: var(--text-muted);
    padding: 8px 0;
    border-bottom: 1px solid #f1f5f9;
  }

  .breakdown-item strong {
    color: var(--secondary-color);
    font-weight: 600;
  }

  .item-title {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .info-helper {
    background: #e2e8f0;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 800;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: help;
  }

  /* --- Results Bottom Action --- */
  .results-bottom-actions {
    padding: 0 30px 30px 30px;
  }

  .btn-primary-results {
    background: var(--accent-color);
    color: #ffffff;
    padding: 15px;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 15px;
    text-align: center;
    display: block;
    box-shadow: 0 4px 12px rgba(243, 112, 33, 0.2);
    transition: var(--transition);
  }

  .btn-primary-results:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(243, 112, 33, 0.3);
    opacity: 0.95;
  }

  .pulse-btn {
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(59, 130, 246, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
    }
  }

  /* --- Dynamic number input style --- */
  .number-input {
    width: 95px;
    padding: 8px 12px;
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-family: var(--font-main);
    font-size: 14px;
    font-weight: 700;
    color: var(--secondary-color);
    text-align: right;
    outline: none;
    transition: var(--transition);
    background: #f8fafc;
  }
  .number-input:focus {
    border-color: var(--accent-color);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
  }
  .number-input::-webkit-outer-spin-button,
  .number-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .number-input[type=number] {
    -moz-appearance: textfield;
  }

  /* --- Bareme Table Styles --- */
  .bareme-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-main);
    background: #ffffff;
  }
  .bareme-table th,
  .bareme-table td {
    padding: 14px 18px;
    border: 1px solid var(--border-color);
    font-size: 14px;
  }
  .bareme-table th {
    font-weight: 800;
    color: var(--secondary-color);
    font-size: 13.5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .bareme-table td {
    color: var(--text-dark);
  }
  .bareme-table tbody tr:hover {
    background: #f8fafc;
  }
  
  @media (max-width: 768px) {
    .bareme-table th,
    .bareme-table td {
      padding: 10px 8px;
      font-size: 12.5px;
    }
    .step-guide-card {
      padding: 20px;
    }
  }

  @media (max-width: 992px) {
    /* Responsive adjustment for Guide Grid */
    section[style*="border-top"] div[style*="display: grid"] {
      grid-template-columns: 1fr !important;
      gap: 20px !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    // ==========================================
    // TAB NAVIGATION LOGIC
    // ==========================================
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        // Toggle active button
        tabButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Toggle active content
        tabContents.forEach(content => {
          if (content.getAttribute('id') === `content-${targetTab}`) {
            content.classList.add('active');
            (content as HTMLElement).style.display = 'block';
          } else {
            content.classList.remove('active');
            (content as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // ==========================================
    // TAB 1: CALCULATION LOGIC (AIDES)
    // ==========================================
    const foyerButtons = document.querySelectorAll('.foyer-btn');
    const foyerSizeInput = document.getElementById('foyer_size') as HTMLInputElement;
    const rfrSlider = document.getElementById('rfr_slider') as HTMLInputElement;
    const rfrDisplay = document.getElementById('rfr_display');
    const heatingCurrentInputs = document.getElementsByName('heating_current');
    const pacPlannedInputs = document.getElementsByName('pac_planned');
    const projectCostInput = document.getElementById('project_cost_input') as HTMLInputElement;
    const projectCostSlider = document.getElementById('project_cost_slider') as HTMLInputElement;

    const resTotalAides = document.getElementById('res_total_aides');
    const resProfileCard = document.getElementById('res_profile_card');
    const resProfileName = document.getElementById('res_profile_name');
    const resProjectCost = document.getElementById('res_project_cost');
    const resRemainingCharge = document.getElementById('res_remaining_charge');
    const resPctText = document.getElementById('res_pct_text');
    const resProgressFill = document.getElementById('res_progress_fill');
    const resPrimeAnah = document.getElementById('res_prime_anah');
    const resPrimeCee = document.getElementById('res_prime_cee');
    const resTvaSaving = document.getElementById('res_tva_saving');

    const ceilingsBleu = [0, 17009, 24875, 29917, 34948, 40002];
    const ceilingsJaune = [0, 21838, 31889, 38349, 44802, 51281];
    const ceilingsViolet = [0, 32894, 47983, 57734, 67473, 77206];

    const getCeilingForFoyer = (foyerSize: number, scale: string) => {
      if (foyerSize <= 5) {
        if (scale === 'Bleu') return ceilingsBleu[foyerSize];
        if (scale === 'Jaune') return ceilingsJaune[foyerSize];
        if (scale === 'Violet') return ceilingsViolet[foyerSize];
      }
      const baseBleu = ceilingsBleu[5];
      const baseJaune = ceilingsJaune[5];
      const baseViolet = ceilingsViolet[5];
      const extraPeople = foyerSize - 5;
      if (scale === 'Bleu') return baseBleu + (extraPeople * 5033);
      if (scale === 'Jaune') return baseJaune + (extraPeople * 6462);
      if (scale === 'Violet') return baseViolet + (extraPeople * 9738);
      return Infinity;
    };

    const calculateAides = () => {
      const foyerSize = parseInt(foyerSizeInput.value, 10);
      const rfr = parseInt(rfrSlider.value, 10);
      const projectCost = parseInt(projectCostInput.value, 10) || 14000;

      let heatingCurrent = 'fioul';
      heatingCurrentInputs.forEach(input => {
        if ((input as HTMLInputElement).checked) heatingCurrent = (input as HTMLInputElement).value;
      });

      let pacPlanned = 'air_eau';
      pacPlannedInputs.forEach(input => {
        if ((input as HTMLInputElement).checked) pacPlanned = (input as HTMLInputElement).value;
      });

      const ceilingBleu = getCeilingForFoyer(foyerSize, 'Bleu');
      const ceilingJaune = getCeilingForFoyer(foyerSize, 'Jaune');
      const ceilingViolet = getCeilingForFoyer(foyerSize, 'Violet');

      let profile = 'Rose';
      if (rfr <= ceilingBleu) profile = 'Bleu';
      else if (rfr <= ceilingJaune) profile = 'Jaune';
      else if (rfr <= ceilingViolet) profile = 'Violet';

      let primeAnah = 0;
      if (pacPlanned === 'air_eau') {
        if (profile === 'Bleu') primeAnah = 9000;
        else if (profile === 'Jaune') primeAnah = 7000;
        else if (profile === 'Violet') primeAnah = 4000;
      } else if (pacPlanned === 'geothermie') {
        if (profile === 'Bleu') primeAnah = 11000;
        else if (profile === 'Jaune') primeAnah = 9000;
        else if (profile === 'Violet') primeAnah = 6000;
      }

      const isCoupDePouceEligible = ['fioul', 'gaz_classique', 'charbon'].includes(heatingCurrent);
      let primeCee = 0;
      if (pacPlanned === 'air_eau' || pacPlanned === 'geothermie') {
        if (isCoupDePouceEligible) {
          if (profile === 'Bleu' || profile === 'Jaune') primeCee = 4500;
          else primeCee = 2500;
        } else {
          primeCee = 500;
        }
      } else if (pacPlanned === 'air_air') {
        primeCee = isCoupDePouceEligible ? 750 : 400;
      }

      let maxPct = 0.30;
      if (profile === 'Bleu') maxPct = 0.90;
      else if (profile === 'Jaune') maxPct = 0.75;
      else if (profile === 'Violet') maxPct = 0.60;

      const totalSubventionsRaw = primeAnah + primeCee;
      const maxAllowedSubventions = Math.round(projectCost * maxPct);
      const totalAides = Math.min(totalSubventionsRaw, maxAllowedSubventions);

      const remainingCharge = Math.max(0, projectCost - totalAides);
      const pctFinanced = Math.round((totalAides / projectCost) * 100) || 0;
      const tvaSaving = Math.round(projectCost * 0.145);

      if (resTotalAides) resTotalAides.innerText = `${totalAides.toLocaleString('fr-FR')} €`;
      if (resProjectCost) resProjectCost.innerText = `${projectCost.toLocaleString('fr-FR')} €`;
      if (resRemainingCharge) resRemainingCharge.innerText = `${remainingCharge.toLocaleString('fr-FR')} €`;
      if (resPrimeAnah) resPrimeAnah.innerText = `${primeAnah.toLocaleString('fr-FR')} €`;
      if (resPrimeCee) resPrimeCee.innerText = `${primeCee.toLocaleString('fr-FR')} €`;
      if (resTvaSaving) resTvaSaving.innerText = `${tvaSaving.toLocaleString('fr-FR')} €`;
      if (resPctText) resPctText.innerText = `${pctFinanced}%`;
      if (resProgressFill) resProgressFill.style.width = `${pctFinanced}%`;

      if (resProfileCard && resProfileName) {
        resProfileCard.className = 'profile-card';
        if (profile === 'Bleu') {
          resProfileCard.classList.add('profile-bleu');
          resProfileName.innerText = 'Profil BLEU (Revenus Très Modestes)';
        } else if (profile === 'Jaune') {
          resProfileCard.classList.add('profile-jaune');
          resProfileName.innerText = 'Profil JAUNE (Revenus Modestes)';
        } else if (profile === 'Violet') {
          resProfileCard.classList.add('profile-violet');
          resProfileName.innerText = 'Profil VIOLET (Revenus Intermédiaires)';
        } else {
          resProfileCard.classList.add('profile-rose');
          resProfileName.innerText = 'Profil ROSE (Revenus Aisés)';
        }
      }
    };

    foyerButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        foyerButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const val = btn.getAttribute('data-value');
        if (val) foyerSizeInput.value = val;
        const size = parseInt(val || '1', 10);
        if (size >= 3) {
          rfrSlider.min = '15000';
          rfrSlider.max = '120000';
        } else {
          rfrSlider.min = '10000';
          rfrSlider.max = '90000';
        }
        calculateAides();
      });
    });

    rfrSlider.addEventListener('input', () => {
      const val = parseInt(rfrSlider.value, 10);
      if (rfrDisplay) rfrDisplay.innerText = `${val.toLocaleString('fr-FR')} €`;
      calculateAides();
    });

    const updateProjectCost = (val: number, source: string) => {
      const value = Math.max(2000, Math.min(40000, val));
      if (source === 'slider') projectCostInput.value = value.toString();
      else projectCostSlider.value = value.toString();
      calculateAides();
    };

    projectCostSlider.addEventListener('input', () => updateProjectCost(parseInt(projectCostSlider.value, 10), 'slider'));
    projectCostInput.addEventListener('change', () => updateProjectCost(parseInt(projectCostInput.value, 10), 'input'));

    const setupRadioCardSelect = (groupName: string, callback: () => void) => {
      const cards = document.querySelectorAll(`input[name="${groupName}"]`);
      cards.forEach(card => {
        const parentLabel = card.closest('.radio-card');
        card.addEventListener('change', () => {
          document.querySelectorAll(`input[name="${groupName}"]`).forEach(c => {
            c.closest('.radio-card')?.classList.remove('active');
          });
          if (card.checked) parentLabel?.classList.add('active');
          callback();
        });
      });
    };

    setupRadioCardSelect('heating_current', calculateAides);
    setupRadioCardSelect('pac_planned', () => {
      let defaultCost = 14000;
      let selectedPac = 'air_eau';
      pacPlannedInputs.forEach(input => {
        if ((input as HTMLInputElement).checked) selectedPac = (input as HTMLInputElement).value;
      });
      if (selectedPac === 'air_air') defaultCost = 6000;
      if (selectedPac === 'geothermie') defaultCost = 22000;
      projectCostInput.value = defaultCost.toString();
      projectCostSlider.value = defaultCost.toString();
      calculateAides();
    });

    // ==========================================
    // TAB 2: CALCULATION LOGIC (PUISSANCE)
    // ==========================================
    const inputSurface = document.getElementById('input_surface') as HTMLInputElement;
    const sliderSurface = document.getElementById('slider_surface') as HTMLInputElement;
    const inputHeight = document.getElementById('input_height') as HTMLInputElement;
    const sliderHeight = document.getElementById('slider_height') as HTMLInputElement;
    const inputAltitude = document.getElementById('input_altitude') as HTMLInputElement;
    const sliderAltitude = document.getElementById('slider_altitude') as HTMLInputElement;
    const insulationInputs = document.getElementsByName('insulation_coef');
    const emittersInputs = document.getElementsByName('emitters_type');

    const resRequiredPower = document.getElementById('res_required_power');
    const resTempBadge = document.getElementById('res_temp_badge');
    const resTempName = document.getElementById('res_temp_name');
    const resHouseVolume = document.getElementById('res_house_volume');
    const resBaseTemp = document.getElementById('res_base_temp');
    const resHeatLosses = document.getElementById('res_heat_losses');
    const resPacRecommendation = document.getElementById('res_pac_recommendation');
    const resSizingAlert = document.getElementById('res_sizing_alert');
    const resWinterCop = document.getElementById('res_winter_cop');
    const resFuelSaving = document.getElementById('res_fuel_saving');
    const resInsulationG = document.getElementById('res_insulation_g');
    const resWaterTemp = document.getElementById('res_water_temp');

    const syncInputs = (numEl: HTMLInputElement, rangeEl: HTMLInputElement, min: number, max: number, callback: () => void, decimals: number = 0) => {
      const updateVal = (val: number, source: string) => {
        let cleanVal = Math.max(min, Math.min(max, val));
        cleanVal = decimals > 0 ? parseFloat(cleanVal.toFixed(decimals)) : Math.round(cleanVal);
        if (source === 'range') numEl.value = cleanVal.toString();
        else rangeEl.value = cleanVal.toString();
        callback();
      };
      rangeEl.addEventListener('input', () => updateVal(parseFloat(rangeEl.value), 'range'));
      numEl.addEventListener('change', () => updateVal(parseFloat(numEl.value), 'num'));
    };

    const calculateSizing = () => {
      const surface = parseFloat(inputSurface.value) || 120;
      const height = parseFloat(inputHeight.value) || 2.5;
      const altitude = parseInt(inputAltitude.value, 10) || 200;

      const volume = surface * height;
      let insulationG = 0.8;
      insulationInputs.forEach(input => {
        if ((input as HTMLInputElement).checked) insulationG = parseFloat((input as HTMLInputElement).value);
      });

      let emittersType = 'low';
      emittersInputs.forEach(input => {
        if ((input as HTMLInputElement).checked) emittersType = (input as HTMLInputElement).value;
      });

      const baseTemp = -9 - Math.floor(Math.max(0, altitude - 200) / 200);
      const deltaT = 20 - baseTemp;
      const lossesW = volume * insulationG * deltaT;
      const losseskW = lossesW / 1000;
      const requiredPowerkW = losseskW * 1.2;

      let waterTemp = 35;
      let winterCop = 3.20;
      let savingsRange = '- 60% à - 75%';

      if (emittersType === 'low') {
        waterTemp = 35;
        winterCop = parseFloat((3.6 - (altitude / 2000) * 0.8).toFixed(2));
        savingsRange = '- 65% à - 78%';
      } else if (emittersType === 'med') {
        waterTemp = 48;
        winterCop = parseFloat((2.9 - (altitude / 2000) * 0.7).toFixed(2));
        savingsRange = '- 55% à - 68%';
      } else if (emittersType === 'high') {
        waterTemp = 65;
        winterCop = parseFloat((2.3 - (altitude / 2000) * 0.5).toFixed(2));
        savingsRange = '- 45% à - 60%';
      }

      if (resRequiredPower) resRequiredPower.innerText = `${requiredPowerkW.toFixed(1)} kW`;
      if (resHouseVolume) resHouseVolume.innerText = `${Math.round(volume)} m³`;
      if (resBaseTemp) resBaseTemp.innerText = `${baseTemp} °C`;
      if (resHeatLosses) resHeatLosses.innerText = `${losseskW.toFixed(2)} kW`;
      if (resWinterCop) resWinterCop.innerText = winterCop.toFixed(2);
      if (resFuelSaving) resFuelSaving.innerText = savingsRange;
      if (resInsulationG) resInsulationG.innerText = insulationG.toFixed(2);
      if (resWaterTemp) resWaterTemp.innerText = `${waterTemp} °C`;

      if (resTempBadge && resTempName && resPacRecommendation && resSizingAlert) {
        resTempBadge.className = 'profile-card';
        resSizingAlert.className = 'summary-row highlight-row';

        if (emittersType === 'high') {
          resTempBadge.classList.add('profile-rose');
          resTempName.innerText = 'Haute Température Obligatoire';
          resPacRecommendation.innerText = 'Haute Température (65°C)';
          resSizingAlert.style.background = '#fdf2f8';
          resSizingAlert.style.borderColor = '#fbcfe8';
          resSizingAlert.style.color = '#9d174d';
          resPacRecommendation.style.color = '#be185d';
        } else if (emittersType === 'med') {
          resTempBadge.classList.add('profile-jaune');
          resTempName.innerText = 'Moyenne Température';
          resPacRecommendation.innerText = 'Moyenne Température (50°C)';
          resSizingAlert.style.background = '#fef9c3';
          resSizingAlert.style.borderColor = '#fef08a';
          resSizingAlert.style.color = '#854d0e';
          resPacRecommendation.style.color = '#a16207';
        } else {
          resTempBadge.classList.add('profile-bleu');
          resTempName.innerText = 'Basse Température Optimisée';
          resPacRecommendation.innerText = 'Basse Température (35°C)';
          resSizingAlert.style.background = '#eff6ff';
          resSizingAlert.style.borderColor = '#bfdbfe';
          resSizingAlert.style.color = '#1e3a8a';
          resPacRecommendation.style.color = '#1d4ed8';
        }
      }
    };

    syncInputs(inputSurface, sliderSurface, 20, 400, calculateSizing);
    syncInputs(inputHeight, sliderHeight, 2.0, 4.5, calculateSizing, 1);
    syncInputs(inputAltitude, sliderAltitude, 0, 2000, calculateSizing);
    setupRadioCardSelect('insulation_coef', calculateSizing);
    setupRadioCardSelect('emitters_type', calculateSizing);

    // ==========================================
    // TAB 3: CALCULATION LOGIC (ÉCONOMIES)
    // ==========================================
    const inputBill = document.getElementById('input_bill') as HTMLInputElement;
    const sliderBill = document.getElementById('slider_bill') as HTMLInputElement;
    const energyInputs = document.getElementsByName('current_energy');
    const targetEmittersInputs = document.getElementsByName('target_emitters');

    const resAnnualSaving = document.getElementById('res_annual_saving');
    const resSavingPercent = document.getElementById('res_saving_percent');
    const resCurrentCost = document.getElementById('res_current_cost');
    const resPacCost = document.getElementById('res_pac_cost');
    const res10yrSavings = document.getElementById('res_10yr_savings');
    const resCo2Reduction = document.getElementById('res_co2_reduction');
    const resThermalGenerated = document.getElementById('res_thermal_generated');
    const resPacElectricity = document.getElementById('res_pac_electricity');
    const resCopFactor = document.getElementById('res_cop_factor');

    const calculateSavings = () => {
      const bill = parseInt(inputBill.value, 10) || 2000;
      let currentEnergy = 'electricity';
      energyInputs.forEach(input => {
        if ((input as HTMLInputElement).checked) currentEnergy = (input as HTMLInputElement).value;
      });

      let targetEmitters = 'floor';
      targetEmittersInputs.forEach(input => {
        if ((input as HTMLInputElement).checked) targetEmitters = (input as HTMLInputElement).value;
      });

      let costPerThermalKwh = 0.2516;
      let currentCo2PerKwh = 0.052;

      if (currentEnergy === 'electricity') {
        costPerThermalKwh = 0.2516;
        currentCo2PerKwh = 0.052;
      } else if (currentEnergy === 'oil') {
        costPerThermalKwh = 0.1560;
        currentCo2PerKwh = 0.324;
      } else if (currentEnergy === 'gas') {
        costPerThermalKwh = 0.1200;
        currentCo2PerKwh = 0.227;
      } else if (currentEnergy === 'wood') {
        costPerThermalKwh = 0.1060;
        currentCo2PerKwh = 0.030;
      }

      const thermalGeneratedKwh = bill / costPerThermalKwh;
      let pacCop = 3.80;
      if (targetEmitters === 'floor') pacCop = 3.80;
      else if (targetEmitters === 'radiators_standard') pacCop = 3.20;
      else if (targetEmitters === 'radiators_fonte') pacCop = 2.60;

      const pacElectricityKwh = thermalGeneratedKwh / pacCop;
      const pacCost = pacElectricityKwh * 0.2516;
      const annualSavings = bill - pacCost;
      const savingsPercent = Math.round((annualSavings / bill) * 100);
      const savings10Yr = annualSavings * 10;

      const currentCo2 = thermalGeneratedKwh * currentCo2PerKwh;
      const pacCo2 = pacElectricityKwh * 0.052;
      const co2Reduction = currentCo2 - pacCo2;

      if (resAnnualSaving) resAnnualSaving.innerText = annualSavings > 0 ? `${Math.round(annualSavings).toLocaleString('fr-FR')} €` : `0 €`;
      if (resSavingPercent) resSavingPercent.innerText = annualSavings > 0 ? `Chauffage financé à ${savingsPercent}% par l'air` : `Économies non significatives`;
      if (resCurrentCost) resCurrentCost.innerText = bill.toLocaleString('fr-FR');
      if (resPacCost) resPacCost.innerText = Math.round(pacCost).toLocaleString('fr-FR');
      if (res10yrSavings) res10yrSavings.innerText = savings10Yr > 0 ? `${Math.round(savings10Yr).toLocaleString('fr-FR')} €` : `0 €`;
      if (resThermalGenerated) resThermalGenerated.innerText = `${Math.round(thermalGeneratedKwh).toLocaleString('fr-FR')} kWh`;
      if (resPacElectricity) resPacElectricity.innerText = `${Math.round(pacElectricityKwh).toLocaleString('fr-FR')} kWh`;
      if (resCopFactor) resCopFactor.innerText = pacCop.toFixed(2);
      if (resCo2Reduction) resCo2Reduction.innerText = co2Reduction > 0 ? `- ${Math.round(co2Reduction).toLocaleString('fr-FR')} kg / an` : `Neutre`;
    };

    syncInputs(inputBill, sliderBill, 400, 8000, calculateSavings);
    setupRadioCardSelect('current_energy', calculateSavings);
    setupRadioCardSelect('target_emitters', calculateSavings);

    // Run all calculations once on load
    calculateAides();
    calculateSizing();
    calculateSavings();
  });
</script>
