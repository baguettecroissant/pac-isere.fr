---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CityMap from '../components/CityMap.astro';
import WasteTypeCrossLinks from '../components/WasteTypeCrossLinks.astro';
import { generateCommuneContent } from '../lib/contentEngine';
import config from '../data/config.json';
import communes from '../data/communes.json';

export async function getStaticPaths() {
  return communes.map((c) => ({
    params: { commune: c.slug },
    props: { data: c }
  }));
}

const { data } = Astro.props;

// Get a few random nearby communes for horizontal linking (same department)
const nearbyCommunes = communes
  .filter(c => c.slug !== data.slug)
  .slice(0, 8);

const content = generateCommuneContent(data, 'main');

const title = `Location de Benne ${data.nom} (${data.codePostal}) | Tarif & Devis - ${config.brandName}`;
const description = `Location de bennes à ${data.nom} (${data.codePostal}). Bennes de 8m³ à 30m³ pour gravats, DIB et déchets verts. Obtenez votre devis gratuit sous 2h.`;

// Calculate local pricing factor based on population
const priceFactor = data.population && data.population > 100000 ? 1.15 : data.population && data.population > 50000 ? 1.08 : 1;
const prices = {
  gravats: Math.round(280 * priceFactor),
  dib: Math.round(390 * priceFactor),
  verts: Math.round(320 * priceFactor),
  bois: Math.round(340 * priceFactor)
};
---

<Layout title={title} description={description}>
  <!-- Hero Section localized -->
  <Hero communeName={data.nom} />

  <!-- Localized SEO content -->
  <section class="features">
    <div class="container" style="max-width: 800px;">
      <div class="section-title">
        <h2>Évacuation et tri de déchets à {data.nom}</h2>
        <p>Location de bennes de 8m³ à 30m³ pour tous vos chantiers</p>
      </div>

      <div style="font-size: 17px; line-height: 1.8; color: var(--text-dark); display: flex; flex-direction: column; gap: 24px;">
        <p>
          {content.introParagraph}
        </p>

        <p>
          En louant votre benne chez <strong>{config.brandName}</strong>, vous vous assurez d'une gestion de déchets éco-responsable. Notre équipe dépose la benne à {data.nom} et se charge de l'enlèvement une fois le chargement terminé. Vos déchets sont acheminés en déchetterie professionnelle agréée du {config.department} pour y être triés, valorisés et recyclés conformément aux normes environnementales de la région Hauts-de-France.
        </p>

        <!-- Dynamic Pricing Table -->
        <h3 style="font-size: 22px; font-weight: 800; color: var(--secondary-color); margin-top: 20px; text-align: center;">
          Tarifs des bennes à {data.nom} (2026)
        </h3>
        <p style="font-size: 15px; color: var(--text-muted); text-align: center; margin-top: -15px;">
          {content.pricesContext}
        </p>
        <div class="form-card" style="padding: 24px; box-shadow: var(--shadow-sm); border-radius: var(--radius-md); margin: 10px 0;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 15px;">
            <thead>
              <tr style="border-bottom: 2px solid var(--border-color); color: var(--secondary-color); font-weight: 700;">
                <th style="padding: 12px 8px;">Catégorie</th>
                <th style="padding: 12px 8px;">Type de Benne</th>
                <th style="padding: 12px 8px; text-align: right;">Tarif Indicatif HT</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 14px 8px;">🪨 <a href={`/location-benne-gravats-${data.slug}`} style="color: var(--accent-color); font-weight: 700;">Gravats & Inertes</a></td>
                <td style="padding: 14px 8px; color: var(--text-muted);">Béton, briques, tuiles (Benne 8m³)</td>
                <td style="padding: 14px 8px; text-align: right; font-weight: 700; color: var(--accent-color);">{prices.gravats} €</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 14px 8px;">📦 <a href={`/location-benne-encombrants-${data.slug}`} style="color: var(--accent-color); font-weight: 700;">Encombrants / DIB</a></td>
                <td style="padding: 14px 8px; color: var(--text-muted);">Meubles, déchets de chantier mixtes (10m³)</td>
                <td style="padding: 14px 8px; text-align: right; font-weight: 700; color: var(--accent-color);">{prices.dib} €</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 14px 8px;">🌿 <a href={`/location-benne-dechets-verts-${data.slug}`} style="color: var(--accent-color); font-weight: 700;">Déchets Verts</a></td>
                <td style="padding: 14px 8px; color: var(--text-muted);">Tontes, branches, troncs (15m³)</td>
                <td style="padding: 14px 8px; text-align: right; font-weight: 700; color: var(--accent-color);">{prices.verts} €</td>
              </tr>
              <tr>
                <td style="padding: 14px 8px;">🏭 <a href={`/location-benne-dib-${data.slug}`} style="color: var(--accent-color); font-weight: 700;">Déchets de Bois</a></td>
                <td style="padding: 14px 8px; color: var(--text-muted);">Palettes, planches, charpentes (30m³)</td>
                <td style="padding: 14px 8px; text-align: right; font-weight: 700; color: var(--accent-color);">{prices.bois} €</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Localized street-use warning box & Mairie External Link -->
        <div style="background: rgba(243, 112, 33, 0.05); border-left: 4px solid var(--accent-color); padding: 24px; border-radius: var(--radius-sm); margin: 20px 0;">
          <h4 style="font-weight: 700; color: var(--secondary-color); margin-bottom: 8px; font-size: 16px;">
            ⚠️ Réglementation de voirie et stationnement à {data.nom}
          </h4>
          <p style="font-size: 15px; color: var(--text-muted); margin-bottom: 12px;">
            {content.logisticsAlert}
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 15px; font-size: 14px; margin-top: 15px;">
            <a 
              href={`https://lannuaire.service-public.gouv.fr/hauts-de-france/nord/mairie-${data.codeInsee}-01`} 
              target="_blank" 
              rel="noopener noreferrer" 
              style="color: var(--accent-color); font-weight: 700; text-decoration: underline;"
            >
              🏛️ Fiche officielle de la Mairie de {data.nom} &rarr;
            </a>
            <a 
              href={`https://www.google.fr/search?q=autorisation+voirie+benne+mairie+${encodeURIComponent(data.nom)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              style="color: var(--secondary-color); font-weight: 700; text-decoration: underline;"
            >
              🔍 Rechercher le formulaire d'autorisation AOT &rarr;
            </a>
          </div>
        </div>

        <!-- Environmental regulations & ADEME external link -->
        <div style="background: rgba(46, 204, 113, 0.03); border-left: 4px solid #2ecc71; padding: 24px; border-radius: var(--radius-sm); margin: 20px 0;">
          <h4 style="font-weight: 700; color: var(--secondary-color); margin-bottom: 8px; font-size: 16px;">
            ♻️ Tri des déchets et transition écologique à {data.nom}
          </h4>
          <p style="font-size: 15px; color: var(--text-muted); margin-bottom: 12px;">
            Conformément à la réglementation sur le tri à la source (décret 7 flux pour les professionnels et loi AGEC), l'évacuation de vos déchets de chantier ou de jardin doit respecter les filières de valorisation locales de la région Hauts-de-France. Pour en savoir plus sur les consignes de recyclage officielles, vous pouvez consulter les guides du ministère et de l'ADEME.
          </p>
          <a 
            href="https://www.ademe.fr/expertises/dechets" 
            target="_blank" 
            rel="noopener noreferrer" 
            style="color: #27ae60; font-weight: 700; text-decoration: underline; font-size: 14px;"
          >
            🌱 Guide ADEME de la gestion et valorisation des déchets &rarr;
          </a>
        </div>

        <!-- Geolocation Map -->
        <h3 style="font-size: 20px; font-weight: 800; color: var(--secondary-color); margin-top: 10px;">
          📍 Zone de livraison à {data.nom}
        </h3>
        <CityMap cityName={data.nom} zip={data.codePostal} departmentName={config.department} />

        <!-- Programmatic FAQ -->
        <h3 style="font-size: 22px; font-weight: 800; color: var(--secondary-color); margin-top: 30px;">
          Questions fréquentes — Location benne {data.nom}
        </h3>
        <div style="display: flex; flex-direction: column; gap: 20px; margin-top: 10px;">
          {content.faqItems.map((faq) => (
            <div style="background: var(--white); border: 1px solid var(--border-color); padding: 20px; border-radius: var(--radius-sm);">
              <h4 style="font-weight: 700; color: var(--secondary-color); font-size: 16px; margin-bottom: 8px;">
                ❓ {faq.question}
              </h4>
              <p style="font-size: 15px; color: var(--text-muted); margin: 0; line-height: 1.6;">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Vertical linking inside the Lille silo -->
  <WasteTypeCrossLinks cityName={data.nom} citySlug={data.slug} currentCategory="main" />

  <!-- Horizontal linking to nearby communes -->
  <section class="cities-section" style="background: var(--bg-color); border-top: 1px solid var(--border-color);">
    <div class="container">
      <div class="section-title">
        <h2>Zones d'intervention proches de {data.nom}</h2>
        <p>Nous desservons également les communes suivantes autour de {data.nom} :</p>
      </div>

      <div class="cities-grid">
        {nearbyCommunes.map((commune) => (
          <a href={`/location-benne-${commune.slug}`} class="city-link">
            <span>📍 {commune.nom}</span>
            <span class="arrow">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
