---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CityMap from '../components/CityMap.astro';
import WasteTypeCrossLinks from '../components/WasteTypeCrossLinks.astro';
import { generateCommuneContent } from '../lib/contentEngine';
import config from '../data/config.json';
import communes from '../data/communes.json';

export async function getStaticPaths() {
  return communes.map((c) => ({
    params: { commune: c.slug },
    props: { data: c }
  }));
}

const { data } = Astro.props;

const nearbyCommunes = communes
  .filter(c => c.slug !== data.slug)
  .slice(0, 6);

const content = generateCommuneContent(data, 'dib');

const title = `Location de Benne DIB / Bois ${data.nom} (${data.codePostal}) | Tarifs 2026 - ${config.brandName}`;
const description = `Louer une benne à bois / DIB à ${data.nom} (${data.codePostal}). Évacuation de palettes, charpentes, menuiseries. Devis gratuit sous 2h, livraison rapide dans le ${config.department}.`;

const priceFactor = data.population && data.population > 100000 ? 1.15 : data.population && data.population > 50000 ? 1.08 : 1;
const price = Math.round(340 * priceFactor);
---

<Layout title={title} description={description}>
  <Hero communeName={data.nom} categoryName="DIB / Bois" />

  <section class="features">
    <div class="container" style="max-width: 800px;">
      <div class="section-title">
        <h2>Location de Benne DIB & Bois à {data.nom}</h2>
        <p>Solution d'évacuation professionnelle pour palettes, poutres, planches et résidus de bois</p>
      </div>

      <div style="font-size: 17px; line-height: 1.8; color: var(--text-dark); display: flex; flex-direction: column; gap: 24px;">
        <p>
          {content.introParagraph}
        </p>

        <p>
          Chez <strong>{config.brandName}</strong>, nous proposons des bennes adaptées aux bois et aux DIB allant de 15m³ à 30m³. Le tarif pour la location d'une benne DIB / bois à {data.nom} commence à partir de <strong>{price} € HT</strong>. {content.pricesContext}
        </p>

        <!-- Waste lists -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin: 20px 0;">
          <div style="background: rgba(46, 204, 113, 0.05); border: 1px solid rgba(46, 204, 113, 0.2); padding: 24px; border-radius: var(--radius-md);">
            <h4 style="font-weight: 700; color: #27ae60; margin-bottom: 15px; font-size: 16px;">🟢 Déchets Acceptés</h4>
            <ul style="list-style-type: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
              <li>✔️ Palettes de manutention en bois</li>
              <li>✔️ Planches, poutres de charpentes non traitées</li>
              <li>✔️ Chutes de coupe, portes et cadres en bois</li>
              <li>✔️ Caisses d'emballage en bois</li>
              <li>✔️ Sciures et copeaux de bois brut</li>
            </ul>
          </div>
          <div style="background: rgba(231, 76, 60, 0.05); border: 1px solid rgba(231, 76, 60, 0.2); padding: 24px; border-radius: var(--radius-md);">
            <h4 style="font-weight: 700; color: #c0392b; margin-bottom: 15px; font-size: 16px;">🔴 Déchets Interdits</h4>
            <ul style="list-style-type: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
              <li>❌ Traverses de chemin de fer (bois traité créosote très toxique)</li>
              <li>❌ Bois brûlé ou souillé d'hydrocarbures</li>
              <li>❌ Produits chimiques liquides, peintures, aérosols</li>
              <li>❌ Plâtre, plaques de BA13 et fibrociment</li>
              <li>❌ Gravats et plastiques mélangés (si benne bois pure)</li>
            </ul>
          </div>
        </div>

        <!-- Localized street-use warning box & Mairie External Link -->
        <div style="background: rgba(243, 112, 33, 0.05); border-left: 4px solid var(--accent-color); padding: 24px; border-radius: var(--radius-sm); margin: 20px 0;">
          <h4 style="font-weight: 700; color: var(--secondary-color); margin-bottom: 8px; font-size: 16px;">
            ⚠️ Réglementation de voirie et stationnement à {data.nom}
          </h4>
          <p style="font-size: 15px; color: var(--text-muted); margin-bottom: 12px;">
            {content.logisticsAlert}
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 15px; font-size: 14px; margin-top: 15px;">
            <a 
              href={`https://lannuaire.service-public.gouv.fr/hauts-de-france/nord/mairie-${data.codeInsee}-01`} 
              target="_blank" 
              rel="noopener noreferrer" 
              style="color: var(--accent-color); font-weight: 700; text-decoration: underline;"
            >
              🏛️ Fiche officielle de la Mairie de {data.nom} &rarr;
            </a>
            <a 
              href={`https://www.google.fr/search?q=autorisation+voirie+benne+mairie+${encodeURIComponent(data.nom)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              style="color: var(--secondary-color); font-weight: 700; text-decoration: underline;"
            >
              🔍 Rechercher le formulaire d'autorisation AOT &rarr;
            </a>
          </div>
        </div>

        <!-- Environmental regulations & ADEME external link -->
        <div style="background: rgba(46, 204, 113, 0.03); border-left: 4px solid #2ecc71; padding: 24px; border-radius: var(--radius-sm); margin: 20px 0;">
          <h4 style="font-weight: 700; color: var(--secondary-color); margin-bottom: 8px; font-size: 16px;">
            ♻️ Tri des déchets et transition écologique à {data.nom}
          </h4>
          <p style="font-size: 15px; color: var(--text-muted); margin-bottom: 12px;">
            Conformément à la réglementation sur le tri à la source (décret 7 flux pour les professionnels et loi AGEC), l'évacuation de vos déchets de chantier ou de jardin doit respecter les filières de valorisation locales de la région Hauts-de-France. Pour en savoir plus sur les consignes de recyclage officielles, vous pouvez consulter les guides du ministère et de l'ADEME.
          </p>
          <a 
            href="https://www.ademe.fr/expertises/dechets" 
            target="_blank" 
            rel="noopener noreferrer" 
            style="color: #27ae60; font-weight: 700; text-decoration: underline; font-size: 14px;"
          >
            🌱 Guide ADEME de la gestion et valorisation des déchets &rarr;
          </a>
        </div>

        <!-- Geolocation Map -->
        <h3 style="font-size: 20px; font-weight: 800; color: var(--secondary-color); margin-top: 10px;">
          📍 Zone de livraison à {data.nom}
        </h3>
        <CityMap cityName={data.nom} zip={data.codePostal} departmentName={config.department} />

        <!-- Programmatic FAQ -->
        <h3 style="font-size: 22px; font-weight: 800; color: var(--secondary-color); margin-top: 30px;">
          Questions fréquentes — Benne DIB / bois {data.nom}
        </h3>
        <div style="display: flex; flex-direction: column; gap: 20px; margin-top: 10px;">
          {content.faqItems.map((faq) => (
            <div style="background: var(--white); border: 1px solid var(--border-color); padding: 20px; border-radius: var(--radius-sm);">
              <h4 style="font-weight: 700; color: var(--secondary-color); font-size: 16px; margin-bottom: 8px;">
                ❓ {faq.question}
              </h4>
              <p style="font-size: 15px; color: var(--text-muted); margin: 0; line-height: 1.6;">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Vertical linking in the Lille silo -->
  <WasteTypeCrossLinks cityName={data.nom} citySlug={data.slug} currentCategory="dib" />

  <!-- Horizontal linking to nearby communes -->
  <section class="cities-section" style="background: var(--bg-color); border-top: 1px solid var(--border-color);">
    <div class="container">
      <div class="section-title">
        <h2>Location de benne DIB / bois près de {data.nom}</h2>
        <p>Nous desservons également les communes suivantes pour vos déchets de bois :</p>
      </div>

      <div class="cities-grid">
        {nearbyCommunes.map((commune) => (
          <a href={`/location-benne-dib-${commune.slug}`} class="city-link">
            <span>📍 {commune.nom}</span>
            <span class="arrow">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
