---
import config from '../data/config.json';
import '../styles/global.css';
import communes from '../data/communes.json';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	headContent?: string;
}

const { 
  title = `${config.brandName} | Chauffage & Climatisation RGE Isère (38)`, 
  description = config.description,
  canonicalUrl
} = Astro.props;

const accentColor = config.accentColor;
const secondaryColor = config.secondaryColor;
const currentYear = new Date().getFullYear();
const siteUrl = `https://${config.domain}`;

// Auto-generate canonical URL from current page if not explicitly passed
const resolvedCanonical = canonicalUrl || `${siteUrl}${Astro.url.pathname}`;

// Top 10 communes for footer
const topFooterCommunes = communes.slice(0, 10);
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={resolvedCanonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={config.brandName} />
		<meta property="og:url" content={resolvedCanonical} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:image" content={`${siteUrl}/images/hero.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteUrl}/images/hero.png`} />

		<!-- Geo meta tags for local SEO -->
		<meta name="geo.region" content="FR-38" />
		<meta name="geo.placename" content={config.mainCity} />

		<!-- Inject brand-specific styles dynamically -->
		<style define:vars={{ accentColor, secondaryColor }}>
			:root {
				--accent-color: var(--accentColor);
				--secondary-color: var(--secondaryColor);
			}
		</style>

		<!-- Schema.org JSON-LD slot -->
		<slot name="head" />
	</head>
	<body>
		<!-- Header -->
		<header>
			<div class="container header-inner">
				<a href="/" class="logo">
					<span>🔥</span> {config.brandName}
				</a>
				<nav class="header-nav" aria-label="Navigation principale">
					<a href="/">Accueil</a>
					<a href="/outils" style="color: var(--accent-color); font-weight: 700;">🧮 Simulateurs Gratuits</a>
					<a href="/aides-financieres">Aides Financières</a>
					<a href="/fonctionnement-pac">Fonctionnement</a>
					<a href="/guides">Guides</a>
					<a href="/communes">Villes</a>
				</nav>
				<a href="#devis" class="contact-btn">
					📋 Devis Gratuit
				</a>
			</div>
		</header>

		<!-- Main Content Slot -->
		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer>
			<div class="container footer-grid-enriched">
				<div class="footer-brand">
					<h3>🔥 {config.brandName}</h3>
					<p>Votre partenaire de confiance pour l'installation, l'entretien et le dépannage de <a href="/fonctionnement-pac" style="color: var(--accent-color);">pompes à chaleur</a> et climatisations en {config.department} ({config.departmentCode}). Comparez 3 devis gratuits d'artisans RGE.</p>
				</div>
				<div class="footer-links">
					<h4>Nos Simulateurs</h4>
					<ul>
						<li><a href="/outils" style="font-weight: 700; color: var(--accent-color);">🛠️ Espace Simulateurs</a></li>
						<li><a href="/aides-financieres">Aides Financières</a></li>
						<li><a href="/fonctionnement-pac">Fonctionnement PAC</a></li>
						<li><a href="/guides">Guides & Conseils</a></li>
						<li><a href="/communes">Toutes les communes (38)</a></li>
					</ul>
				</div>
				<div class="footer-links">
					<h4>PAC à {config.mainCity}</h4>
					<ul>
						<li><a href="/pompe-a-chaleur-air-eau-grenoble">💧 PAC Air/Eau Grenoble</a></li>
						<li><a href="/pompe-a-chaleur-air-air-grenoble">❄️ Clim Réversible Grenoble</a></li>
						<li><a href="/pompe-a-chaleur-geothermie-grenoble">🌍 Géothermie Grenoble</a></li>
						<li><a href="/entretien-pompe-a-chaleur-grenoble">🔧 Entretien PAC Grenoble</a></li>
					</ul>
				</div>
				<div class="footer-links">
					<h4>Villes populaires</h4>
					<ul>
						{topFooterCommunes.map((c) => (
							<li><a href={`/installation-pompe-a-chaleur-${c.slug}`}>{c.nom}</a></li>
						))}
					</ul>
				</div>
			</div>
			<div class="container footer-bottom">
				<p>&copy; {currentYear} {config.brandName}. Tous droits réservés.</p>
				<p>
					<a href="/mentions-legales">Mentions Légales</a> | 
					<a href="/politique-confidentialite">RGPD</a>
				</p>
			</div>
		</footer>

		<!-- Exit Intent Popup -->
		<ExitIntentPopup />
	</body>
</html>
