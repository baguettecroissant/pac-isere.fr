---
import config from '../data/config.json';
import '../styles/global.css';
import communes from '../data/communes.json';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	headContent?: string;
}

const { 
  title = `${config.brandName} | Location de Benne ${config.mainCity} & ${config.department}`, 
  description = config.description,
  canonicalUrl
} = Astro.props;

const accentColor = config.accentColor;
const secondaryColor = config.secondaryColor;
const currentYear = new Date().getFullYear();
const siteUrl = `https://${config.domain}`;

// Auto-generate canonical URL from current page if not explicitly passed
const resolvedCanonical = canonicalUrl || `${siteUrl}${Astro.url.pathname}`;

// Top 10 communes for footer
const topFooterCommunes = communes.slice(0, 10);
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={resolvedCanonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={config.brandName} />
		<meta property="og:url" content={resolvedCanonical} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:image" content={`${siteUrl}/images/hero.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteUrl}/images/hero.png`} />

		<!-- Geo meta tags for local SEO -->
		<meta name="geo.region" content="FR-59" />
		<meta name="geo.placename" content={config.mainCity} />

		<!-- Inject brand-specific styles dynamically -->
		<style define:vars={{ accentColor, secondaryColor }}>
			:root {
				--accent-color: var(--accentColor);
				--secondary-color: var(--secondaryColor);
			}
		</style>

		<!-- Schema.org JSON-LD slot -->
		<slot name="head" />
	</head>
	<body>
		<!-- Header -->
		<header>
			<div class="container header-inner">
				<a href="/" class="logo">
					<span>🔥</span> {config.brandName}
				</a>
				<nav class="header-nav" aria-label="Navigation principale">
					<a href="/">Accueil</a>
					<a href="/tarifs">Tarifs</a>
					<a href="/types-bennes">Nos Bennes</a>
					<a href="/guides">Guides & Conseils</a>
					<a href="/communes">Villes (59)</a>
				</nav>
				<a href="#devis" class="contact-btn">
					📋 Devis Gratuit
				</a>
			</div>
		</header>

		<!-- Main Content Slot -->
		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer>
			<div class="container footer-grid-enriched">
				<div class="footer-brand">
					<h3>🔥 {config.brandName}</h3>
					<p>Votre partenaire de confiance pour la <a href="/types-bennes" style="color: var(--accent-color);">location de bennes</a> à gravats, DIB, déchets verts et encombrants dans tout le département du {config.department} ({config.departmentCode}). Consultez nos <a href="/tarifs" style="color: var(--accent-color);">tarifs transparents</a>.</p>
				</div>
				<div class="footer-links">
					<h4>Nos Services</h4>
					<ul>
						<li><a href="/#devis">Demande de Devis</a></li>
						<li><a href="/tarifs">Tarifs par Volume</a></li>
						<li><a href="/types-bennes">Guide des Bennes</a></li>
						<li><a href="/guides">Guides & Conseils</a></li>
						<li><a href="/communes">Toutes les communes (59)</a></li>
					</ul>
				</div>
				<div class="footer-links">
					<h4>Bennes à {config.mainCity}</h4>
					<ul>
						<li><a href="/location-benne-gravats-lille">🪨 Gravats Lille</a></li>
						<li><a href="/location-benne-encombrants-lille">📦 Encombrants Lille</a></li>
						<li><a href="/location-benne-dechets-verts-lille">🌿 Déchets Verts Lille</a></li>
						<li><a href="/location-benne-dib-lille">🏭 DIB / Bois Lille</a></li>
					</ul>
				</div>
				<div class="footer-links">
					<h4>Villes populaires</h4>
					<ul>
						{topFooterCommunes.map((c) => (
							<li><a href={`/location-benne-${c.slug}`}>{c.nom}</a></li>
						))}
					</ul>
				</div>
			</div>
			<div class="container footer-bottom">
				<p>&copy; {currentYear} {config.brandName}. Tous droits réservés.</p>
				<p>
					<a href="/mentions-legales">Mentions Légales</a> | 
					<a href="/politique-confidentialite">RGPD</a>
				</p>
			</div>
		</footer>
	</body>
</html>
